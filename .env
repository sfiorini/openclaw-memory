# OpenClaw image
OPENCLAW_IMAGE=openclaw:local

# Gateway runtime
OPENCLAW_GATEWAY_TOKEN=change-me
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Claude/session credentials (set real values before runtime)
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=
PLAYWRIGHT_BROWSERS_PATH=

# Persistent host paths
OPENCLAW_CONFIG_DIR=./openclaw-data/config
OPENCLAW_WORKSPACE_DIR=./openclaw-data/workspace
OPENCLAW_MEMORY_HYBRID_DIR=./openclaw-data/memory-hybrid

# Embeddings key for memory-hybrid plugin
OPENAI_API_KEY=
